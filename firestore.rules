rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an Admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Rules for the users collection
    match /users/{userId} {
      allow read, write: if true;
      
      // Subcollection for user interviews
      match /interviews/{interviewId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Rules for friendRequests collection
    match /friendRequests/{requestId} {
      allow read, write: if true;
    }

    // Rules for calls collection and candidate subcollections
    match /calls/{callId} {
      allow read, write: if true;
      match /callerCandidates/{candId} {
        allow read, write: if true;
      }
      match /receiverCandidates/{candId} {
        allow read, write: if true;
      }
    }

    // Rules for messages collection
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Rules for listing all users
    match /users {
      allow list: if true;
      allow create: if true;
    }

    // Rules for the feedback collection
    match /feedback/{feedbackId} {
      allow create: if true; // Anyone can submit feedback
      allow read, update, delete: if isAdmin();
    }
    match /feedback {
      allow list: if isAdmin();
    }

    // Rules for the interviews collection
    match /interviews/{interviewId} {
      allow read, write: if isAdmin();
    }
    match /interviews {
      allow list: if isAdmin();
    }

    // Rules for the interviewsfeedback collection
    match /interviewsfeedback/{feedbackId} {
      allow read, write: if isAdmin();
    }
    match /interviewsfeedback {
      allow list: if isAdmin();
    }
  }
}
