rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an Admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Rules for the users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // On creation, allow user to set their details but role MUST be "User" (not Admin)
      allow create: if request.auth != null && request.auth.uid == userId && 
        request.resource.data.role == 'User';

      allow update: if request.auth != null && (
        // A user can update their own profile but cannot change their role or status
        (request.auth.uid == userId && 
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'email']))
        ) ||
        // Admins can update any user's profile/role
        isAdmin()
      );

      allow delete: if isAdmin();
      
      // Subcollection for user interviews
      match /interviews/{interviewId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Rules for friendRequests collection
    match /friendRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      allow create: if request.auth != null && 
        request.resource.data.senderId == request.auth.uid;
      allow update: if request.auth != null && (
        // Allow receiver to accept/decline request
        resource.data.receiverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      );
      allow delete: if request.auth != null && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
    }

    // Rules for calls collection and candidate subcollections
    match /calls/{callId} {
      allow read, write: if request.auth != null;
      match /callerCandidates/{candId} {
        allow read, write: if request.auth != null;
      }
      match /receiverCandidates/{candId} {
        allow read, write: if request.auth != null;
      }
    }

    // Rules for messages collection
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Rules for listing all users
    match /users {
      allow list: if isAdmin();
      allow create: if request.auth != null;
    }

    // Rules for the feedback collection
    match /feedback/{feedbackId} {
      allow create: if true; // Anyone can submit feedback
      allow read, update, delete: if isAdmin();
    }
    match /feedback {
      allow list: if isAdmin();
    }

    // Rules for the interviews collection
    match /interviews/{interviewId} {
      allow read, write: if isAdmin();
    }
    match /interviews {
      allow list: if isAdmin();
    }

    // Rules for the interviewsfeedback collection
    match /interviewsfeedback/{feedbackId} {
      allow read, write: if isAdmin();
    }
    match /interviewsfeedback {
      allow list: if isAdmin();
    }

    // Rules for settings collection (e.g. maintenance mode)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
